<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.noclab</groupId>
  <artifactId>game-service</artifactId>
  <version>1.0.0</version>
  <name>game-service</name>
  <description>NOC-to-SRE lab game backend — leaderboard + session API</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Added 2026-08-20: without this, /actuator/prometheus doesn't exist at
         all (actuator alone only gives health/info-style JSON endpoints).
         This is what lets Prometheus actually scrape JVM + HTTP metrics -
         docker/prometheus/prometheus.yml already has the game_service scrape
         job defined (net-new), it's just been sitting there DOWN until now. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Added for the casino-lab work (Stage 0): application.yml's ddl-auto
         comment has said "use migrations in real prod" since the day it was
         written. This is that - Hibernate stops creating/altering tables on
         its own, Flyway takes over the schema, versioned and checked into
         git. V1 baselines the players table exactly as Hibernate had been
         creating it, so this is a behavior-neutral change, not a schema
         change - that's what Stage 0's Docker proof is checking. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <!-- Added for the casino-lab work (Stage 1): accounts need password
         hashing. This is the small spring-security-crypto library only -
         just BCryptPasswordEncoder - not the full spring-boot-starter-security
         starter, which would also add default login forms/filters that
         would clash with the existing REST-only API style. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- Added for the casino-lab work (Stage 1): sends the email-verification
         one-time code. Points at a local mail-catcher container in every
         environment (docker-compose.test.yml, and the real lab's compose
         stack) - no real email is ever sent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- Added for the casino-lab work (Stage 1): the design doc calls for
         the login session to be tracked via a Redis-backed cookie. This
         starter makes Spring's normal HttpSession transparently store its
         data in Redis instead of in local JVM memory - the login code
         doesn't have to know the difference. -->
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>game-service-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
