          "expr": "sum by (host) (jvm_memory_used_bytes{area=\"heap\", host=~\"$host\"})",
          "legendFormat": "{{host}} - used",
          "refId": "A",
          "datasource": "Prometheus"
        },
        {
          "expr": "max by (host) (jvm_gc_max_data_size_bytes{host=~\"$host\"})",
          "legendFormat": "{{host}} - max",
          "refId": "B",
